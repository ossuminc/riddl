domain HandlerTypes is {
  context TypeCtx is {
    event SomeEvent is { what: String }
    command SomeCommand is { data: String }
    record RecordType is { field1: String }

    repository EventRepo is {
      schema RepoSchema is flat
        of records as record RecordType
      with { briefly as "Repo schema" }

      handler EventHandler is {
        on event SomeEvent {
          do "handling event in repo"
        }
      }
    } with {
      explained as "Repository that handles events"
    }

    projector EventProjector is {
      record ProjRecord is { field1: String }
      handler EventProjHandler is {
        on event SomeEvent {
          do "handling event in projector"
        }
      }
    } with {
      explained as "Projector that handles events"
    }
  } with {
    explained as "Context for handler type tests"
  }
} with {
  explained as "Domain for handler type tests"
}
