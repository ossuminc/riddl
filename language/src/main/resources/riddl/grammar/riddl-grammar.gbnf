epic-include ::= "include" ws1 literal-string
use-case ::= "case" ws1 identifier ws1 is ws "{" ws user-story ws (undefined | interactions)* ws "}" ws (with-metadata)?
user-story-verb ::= "wants" | "must" | "shall" | "should" | "may" | "will" | "can"
user-story ::= user-ref ws1 user-story-verb ws ("to")? ws literal-string ws "so" ws ("that")? ws literal-string
interactions ::= (interaction | comment)*
interaction ::= parallel-interactions | optional-interactions | sequential-interactions | step-interactions
parallel-interactions ::= "parallel" ws "{" ws interactions ws "}"
optional-interactions ::= "optional" ws "{" ws interactions ws "}"
sequential-interactions ::= "sequence" ws "{" ws interactions ws "}"
step-interactions ::= "step" ws (focus-on-group-step | direct-user-to-url | select-input-step | refusal-step | take-input-step | show-output-step | self-processing-step | send-message-step | arbitrary-step | vague-step)
focus-on-group-step ::= "focus" ws1 user-ref ws "on" ws1 group-ref ws (with-metadata)?
direct-user-to-url ::= "direct" ws1 user-ref ws "to" ws1 http-url ws (with-metadata)?
select-input-step ::= user-ref ws "selects" ws1 input-ref ws (with-metadata)?
refusal-step ::= any-interaction-ref ws "refuses" ws1 user-ref ws1 literal-string ws (with-metadata)?
take-input-step ::= "take" ws1 input-ref ws "from" ws1 user-ref ws (with-metadata)?
show-output-step ::= "show" ws1 output-ref ws "to" ws1 user-ref ws (with-metadata)?
self-processing-step ::= "for" ws1 any-interaction-ref ws1 is ws1 literal-string ws (with-metadata)?
send-message-step ::= "send" ws1 message-ref ws "from" ws1 any-interaction-ref ws "to" ws1 processor-ref ws (with-metadata)?
arbitrary-step ::= "from" ws1 any-interaction-ref ws1 literal-string ws ("to")? ws any-interaction-ref ws (with-metadata)?
vague-step ::= is ws1 literal-string ws1 literal-string ws1 literal-string ws (with-metadata)?

# User-related
user ::= "user" ws1 identifier ws1 is ws1 literal-string ws (with-metadata)?

# Author-related
author ::= "author" ws1 identifier ws1 is ws "{" ws ((undefined | ("name" is literal-string "email" is literal-string ("organization" is literal-string)? ("title" is literal-string)? ("url" is http-url)?)))? ws "}" ws (with-metadata)?

# URLs
http-url ::= ("http" | "https") "://" host-string (":" port-num)? "/" (url-path)?
host-string ::= [A-Za-z0-9-]+ ( "." [A-Za-z0-9-]+ )*
port-num ::= [0-9]+
url-path ::= [A-Za-z0-9_.~!$&'()*+,;=/-]*

# Metadata
with-metadata ::= ("with" "{" (undefined | (meta-data)*)* "}")?
meta-data ::= brief-description | description | term | option | author-ref | figma-ref | attachment | comment
brief-description ::= briefly ws1 by-as ws1 literal-string
description ::= described ws (by-as doc-block | ("at" http-url) | ("in" "file" literal-string))
term ::= "term" ws1 identifier ws1 is ws1 doc-block
figma-ref ::= "figma" ws1 literal-string ws "node" ws1 literal-string
option ::= "option" ws1 is ws1 option-name ws ("(" (literal-string)* ")")?
option-name ::= [a-z0-9_-]*
attachment ::= "attachment" ws (ulid-attachment-body | named-attachment-body)
ulid-attachment-body ::= "ULID" ws1 is ws1 literal-string
named-attachment-body ::= identifier ws1 is ws1 mime-type ws (("in" "file" literal-string) | (by-as literal-string))
doc-block ::= "{" (markdown-lines | literal-strings | undefined)* "}" | literal-string
markdown-lines ::= (markdown-line)+
markdown-line ::= "|" [^\n]* "\n"?
literal-strings ::= (literal-string)+
shown-by ::= "shown" ws "by" ws "{" ws (http-url)* ws "}"
mime-type ::= ("application" | "audio" | "example" | "font" | "image" | "model" | "text" | "video") "/" [a-z.*-]*
