// A25: the `foreach` statement — bounded iteration over a collection.
// Exercises both collection forms: a `field <path>` FieldRef (here the handled
// message's collection field) and a bare identifier naming a `let`-bound local.
domain Foreach is {
  context Orders is {
    record Order is { id: Integer }
    type OrderList is many Order
    command PlaceBatch is { orders: OrderList }
    handler Batching is {
      on command PlaceBatch {
        let localBatch: OrderList = "the orders to process"
        foreach anOrder in field PlaceBatch.orders {
          do "process the order taken from the message field"
        }
        foreach anOrder in localBatch {
          do "process the order taken from the local"
        }
      }
    }
  }
}
