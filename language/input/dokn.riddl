domain dokn is {
    type Address = {
        line1: String,
        line2: String,
        line3: String,
        line4: String,
        city: String,
        province: String,
        country: String,
        postalCode: String
    }
    type MobileNumber = Pattern("\\(([0-9]{3})\\)([0-9]{3})-([0-9]{4})")

    type EmailAddress = Pattern(
       "^[a-zA-Z0-9_+&*-] + (?:\\.[a-zA-Z0-9_+&*-] + )*@(?:[a-zA-Z0-9-]+\\.) + [a-zA-Z]{2,7}"
    )
    type LoadingMethod = any of { dock, tailgate, forklift, none }
    type CompanyId = Id(dokn.Companies.Company)
    type DriverId = MobileNumber
    type NoteId = Id(dokn.Notes.Note)
    type MediaId is Id(dokn.Media.Medium)
    type LocationId is Id(dokn.Locations.Location)
    type NoteList is reference to entity dokn.Notes.Note

    context Companies is {
        flow events is {
          inlet CompanyEvents_in is type dokn.Companies.Company.CompanyEvent
          outlet CompanyEvents_out is type dokn.Companies.Company.CompanyEvent
        }
        connector CompanyEvents is {
          from outlet CompanyEvents_out to inlet CompanyEvents_in
        }

        entity Company is {

            command AddCompany yields event CompanyAdded is {
              mailingAddress: Address,
              primaryContactName: String,
              primaryContactPhone: MobileNumber,
              primaryContactEmail: EmailAddress
            }
            event CompanyAdded is { when: TimeStamp }
            // Locations.Location publishes its events on this same outlet (there is only one
            // event channel in this model), so the declared type has to admit them. Until the
            // send/portlet conformance check landed (2026-08-19) the alternation named only
            // CompanyAdded while four Location events were placed on it, and nothing said so.
            type CompanyEvent is one of {
              event CompanyAdded or
              event dokn.Locations.Location.DeliveryLocationAdded or
              event dokn.Locations.Location.LocationNameChanged or
              event dokn.Locations.Location.TicketReportedAtLocation or
              event dokn.Locations.Location.NotesForLocationModified
            }

            record fields is {
              companyId: CompanyId,
              mailingAddress: Address,
              primaryContactName: String,
              primaryContactPhone: MobileNumber,
              primaryContactEmail: EmailAddress
            }
            state CompanyBase of record Company.fields
            handler CompanyBaseHandler is {
                on command AddCompany {
                    yield event CompanyAdded(when = "now")
                    send event CompanyAdded(when = "now") to outlet CompanyEvents_out
                }
                on event CompanyAdded { ??? }
            }
        } with {
          option event-sourced
          option available
        }
    }

    context Drivers is {
        flow DriverMessages is {
          inlet Driver_in is type DriverCommands
          outlet Driver_out is type DriverEvents
        }

        entity Driver is {

            command AddDriverToCompany yields event DriverAddedToCompany is  { name: String, mobile: MobileNumber, companyId: CompanyId }
            event DriverAddedToCompany is { name: String, mobile: MobileNumber, companyId: CompanyId }

            command RemoveDriverFromCompany yields event DriverRemovedFromCompany is { mobile: MobileNumber, companyId: CompanyId }
            event DriverRemovedFromCompany is { mobile: MobileNumber, companyId: CompanyId }

            command PlaceDriverOnDuty is { mobile: MobileNumber }

            type DriverCommands is one of { AddDriverToCompany,
                RemoveDriverFromCompany, PlaceDriverOnDuty }

            type DriverEvents is one of { DriverAddedToCompany,
               DriverRemovedFromCompany }

            record fields is {
              driverId: DriverId,
              name: String,
              onDutyTime: TimeStamp,
              companyId: CompanyId
            }
            state DriverBase of record Driver.fields
            handler DriverBaseHandler is {
                on command AddDriverToCompany {
                  yield event DriverAddedToCompany(name = "the driver name", mobile = "the mobile number", companyId = "the company id")
                  send event DriverAddedToCompany(name = "the driver name", mobile = "the mobile number", companyId = "the company id") to outlet Driver_out
                }
                on command RemoveDriverFromCompany {
                  yield event DriverRemovedFromCompany(mobile = "the mobile number", companyId = "the company id")
                  send event DriverRemovedFromCompany(mobile = "the mobile number", companyId = "the company id") to outlet Driver_out
                }
                on event DriverAddedToCompany { ??? }
                on event DriverRemovedFromCompany { ??? }
            }
        } with {
          option event-sourced option available
        }
    }

    context Notes is {
        entity Note is {
            record fields is {
              noteId: NoteId,
              locationId: type LocationId,
              companyId: type CompanyId,
              text: String,
              upvoteCount: Integer,
              downvoteCount: Integer,
              approved: Boolean
            }
            state NoteBase of record Note.fields
            handler NoteBaseHandler is { ??? }
        } with {
            option event-sourced option available
        }
    }

    context Media is {
        entity Medium is {
            record fields is {
              mediaId: MediaId,
              path: String,
              companyId: CompanyId
            }
            state MediaBase of record Medium.fields
            handler MediaBaseHandler is { ??? }
        } with {
            option consistent
        }
    }

    context Locations is {
        entity Location is {

            command AddDeliveryLocation yields event DeliveryLocationAdded is  {
              geohash: Location, label: String
            }
            event DeliveryLocationAdded is { ??? }

            command ChangeLocationName yields event LocationNameChanged is { newName: String }
            event LocationNameChanged is { newName: String }

            command ReportTicketReceived yields event TicketReportedAtLocation is { ??? }
            event TicketReportedAtLocation is { ??? }

            command ModifyNotesAtLocation yields event NotesForLocationModified is { cid: CompanyId, note: String }
            event NotesForLocationModified is { note: String }

            event LocationAddressReceived is { newAddress: dokn.Address }

            query getLocationDetails is { ??? }
            result LocationDetails is { ??? }

            query getLocationNotes is { cid: CompanyId }
            result LocationNotes is { notes: NoteList }

            record fields is {
              locationId: type LocationId,
              geohash:  Location,
              label: String ,
              address: type Address,
              notes: type NoteList,
              ticketCount: Integer,
              loadingMethod: type LoadingMethod
            }
            state LocationBase of record Location.fields
            handler Base is {
              on command Location.AddDeliveryLocation {
                yield event Location.DeliveryLocationAdded
                send event Location.DeliveryLocationAdded to outlet CompanyEvents_out
              }
              on command ChangeLocationName {
                yield event Location.LocationNameChanged(newName = "the new name")
                send event Location.LocationNameChanged(newName = "the new name") to outlet CompanyEvents_out
              }
              on command ReportTicketReceived {
                yield event Location.TicketReportedAtLocation
                send event Location.TicketReportedAtLocation to outlet CompanyEvents_out
              }
              on command ModifyNotesAtLocation {
                yield event Location.NotesForLocationModified(note = "the note")
                send event Location.NotesForLocationModified(note = "the note") to outlet CompanyEvents_out
              }
              on event Location.DeliveryLocationAdded { ??? }
              on event Location.LocationNameChanged { ??? }
              on event Location.TicketReportedAtLocation { ??? }
              on event Location.NotesForLocationModified { ??? }
              on event Location.LocationAddressReceived {
                set field LocationBase.address to "field Location.LocationAddressReceived.newAddress"
              }
              on query Location.getLocationDetails {
                reply result Location.LocationDetails
              }
              on query Location.getLocationNotes {
                reply result Location.LocationNotes(notes = "the notes")
              }
            }
        } with {
          option event-sourced option available
        }
    }
} with {
  explained as {
    |The dokn domain is the starting point for a simple application which allows
    |delivery drivers to capture notes about delivery locations to create
    |efficiency for future deliveries. The main Entities within this domain are:
    |*Driver - a person who delivers parcels and freight deliveries to a
    |specific location.
    |*Location - A specific geographic location to which a driver delivers to.
    |*Note - Drivers capture notes about delivering to a specific location.
    |i.e. Accepts deliveries at loading dock C. Ask for Mike (555-123-4567)
  }
}
