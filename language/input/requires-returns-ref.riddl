// Corpus fixture for A9: `requires`/`returns` reference a named Type (preferred over an inline
// aggregation). Exercised by both the fastparse parser (RequiresReturnsRefFileTest) and the
// EBNF/TatSu grammar so the two accept the same input. Covers a bare type-alias reference, a
// keyworded record reference, and (for the deprecation path) the legacy inline aggregation.
domain d is {
  context c is {
    type Age is Integer
    record Args is { a: Integer, b: String }
    record Result is { ok: Boolean }
    function Unary is {
      requires Age
      returns Result
      ???
    }
    function WithRecord is {
      requires record Args
      returns record Result
      ???
    }
    function LegacyInline is {
      requires { a: Integer }
      returns { ok: Boolean }
      ???
    }
  }
}
