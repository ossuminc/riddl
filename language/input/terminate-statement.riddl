// Corpus fixture exercising `terminate` (Task 5, processor-instance identity): `terminate` ends
// an instance by invoking its `on term`. Parens are OPTIONAL and present exactly when there are
// arguments -- both forms are exercised here. Exercised by both fastparse (TerminateFileTest) and
// the EBNF/TatSu grammar (ebnf_tatsu_validator.py, which scans every input-directory riddl file).
domain TerminateValue is {
  context Orders is {
    record Fields is { total: String } with { briefly "order totals" }
    entity Order is {
      state S of record Fields is {
        handler H is {
          on init(total: String) {
            do "seed the initial total"
          }
          on term(oid: Id(entity Order)) {
            do "release resources"
          }
        } with { briefly "h" }
      } with { briefly "s" }
    } with { briefly "e" }
    entity Widget is {
      state S of record Fields is {
        handler H is {
          on init {
            do "no parameters"
          }
          on term {
            do "no parameters"
          }
        } with { briefly "h" }
      } with { briefly "s" }
    } with { briefly "e" }
    entity Caller is {
      state CS of record Fields is {
        handler CH is {
          on init {
            let orderId = initiate entity Order("5")
            terminate entity Order(orderId)
            terminate entity Widget
          }
        } with { briefly "ch" }
      } with { briefly "cs" }
    } with { briefly "ce" }
  } with { briefly "c" }
} with { briefly "d" }
