// A54/A45/A45b/A57: value expressions (constructor, get-value, value-ref) exercised through the
// `put` (application/context handler) and `return` (function body) statements. Accepted by both the
// fastparse parser and the EBNF/TatSu grammar, which must stay in lockstep.
domain Values is {
  context Calc is {
    type Args is record { a: Integer, b: Integer }
    type Sum is record { total: Integer }
    function Add is {
      requires record Args
      returns record Sum
      // A57: return a record constructor built with a named argument.
      return record Sum(total = "the computed total")
    }
  }
  application context UI is {
    type Greeting is record { text: String }
    command Refresh is { ??? }
    group Main is {
      form Entry acquires type Greeting
      output Panel presents type Greeting
    }
    handler Screen is {
      on command Refresh {
        // A45/A45b: publish a value read from a UI input to a UI output.
        put get from input Entry to output Panel
      }
    }
  }
  // A54: operand widening — send/morph/set/let/yield accept constructors, prompts and value refs.
  context Ordering is {
    type Qty is Integer
    record Line is { sku: String, qty: Qty }
    command AddLine is { sku: String }
    event LineAdded is { sku: String }
    result Ack is { ok: String }
    outlet added is event LineAdded
    entity Cart is {
      record CartData is { line: Line }
      state Open of record CartData
      handler Ops is {
        on command AddLine {
          // A54: `let` bound to an AI-computed prompt value.
          let note = prompt("summarize the addition")
          // A54: `set` a record field via a constructor value.
          set field Cart.Open.line to record Line(sku = "abc", qty = "1")
          // A54: `send` an event built by a constructor to an outlet.
          send event LineAdded(sku = "abc") to outlet Ordering.added
          // A54: `morph` the entity state with a record constructor.
          morph entity Cart to state Cart.Open with record CartData(line = record Line(sku = "x", qty = "2"))
        }
      }
    }
  }
  // A28: the boolean-expression sub-language exercised through `let`/`set`. Comparisons, logical
  // and/or/not, precedence, parenthesization, and boolean literals all parse and validate here.
  context Flags is {
    command Check is { threshold: Integer }
    // A28 s3: a numeric constant used as a type-safe comparison operand (no magic-number literals).
    constant MaxCount is Integer = "100"
    entity Gate is {
      record GateData is { count: Integer, active: Boolean, open: Boolean }
      state Status of record GateData
      handler Ops is {
        on command Check {
          // A28: comparison + logical `and` + `not` over message/state fields (a > b and not c).
          let ok = count > threshold and not active
          // A28 s3: compare a field against a numeric `constant` — bare path and `constant` keyword.
          let underMax = count > MaxCount
          let underMax2 = count > constant MaxCount
          // A28: a bare boolean literal.
          let always = true
          // A28: parenthesization overrides precedence ((a or b) grouped, then `and`).
          let either = (active or open) and ok
          // A28: `set` a boolean field to a comparison (set f to a == b).
          set field Gate.Status.open to count == threshold
        }
      }
    }
  }
  // A28 slice 2: structured boolean expressions as when/require/invariant CONDITIONS (not just
  // let/set values). Exercises the widened condition parsers so the EBNF/TatSu grammar covers them.
  context Conditions is {
    command Act is { count: Integer }
    entity Guard is {
      record GuardData is { count: Integer, total: Integer, active: Boolean }
      state GState of record GuardData
      // A28: an invariant condition as a structured comparison (was: opaque literal string only).
      invariant balanced is count == total
      handler Rules is {
        on command Act {
          // A28: a `require` condition as a comparison (was: literal string / invariant ref only).
          require count == total
          // A28: a `when` condition as a structured boolean expression (was: literal / identifier).
          when count > total and not active then
            error "over"
          end
        }
      }
    }
  }
}
