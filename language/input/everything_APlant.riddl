context APlant is {
  source Source is { outlet OutCommands is command DoAThing } with { described as "Data Source" }
  sink Sink is { inlet InCommands is command DoAThing } with { described as "Data Sink" }

  connector AChannel is {
    from outlet Source.OutCommands
    to inlet Sink.InCommands
  } with { described as "A Channel" }
} with { described as "A bunch of data flow connections" }
