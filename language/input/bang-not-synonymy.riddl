// Corpus fixture for the `2026-08-15-not-bang-synonymy` plan (task 5): a fixture under
// `**/input/**/*.riddl` so the CI TatSu grammar validator actually sees `!` syntax --
// without one here, the parser/EBNF sync is asserted by the unit suites (tasks 1-4) but never
// checked in CI. Precedent: `numeric-literals.riddl` immediately exposed a real TatSu divergence
// (`1e3`) that no internal test could have found.
//
// Reid's 2026-08-14 ruling: `not` and `!` are synonymous everywhere, as the inverse of a boolean
// expression. Exercises every position from Task 1's table -- `when`, `require`, `let`,
// parenthesised, doubled, applied to a comparison -- plus the `!=` guard, which must still parse
// as a comparison and never as `!` applied to `= b`.
domain BangNotSynonymy is {
  context Guards is {
    command Check is { isValid: Boolean, a: Integer, b: Integer, flag: Boolean }
    entity Gate is {
      record GateData is { count: Integer }
      state Status of record GateData
      handler Ops is {
        on command Check {
          // when: bare identifier
          when !isValid then
            error "invalid"
          end
          // require: bare identifier
          require !isValid
          // let: bare identifier
          let notValid = !isValid
          // parenthesised
          when !(a and b) then
            error "both"
          end
          // doubled
          when !!flag then
            error "doubled"
          end
          // applied to a comparison
          when !a > b then
            error "comparison"
          end
          // the `!=` guard: must still parse as a comparison, never as `!` applied to `= b`
          when a != b then
            error "not equal"
          end
          when (a != b) then
            error "not equal, parenthesised"
          end
        }
      }
    }
  }
}
