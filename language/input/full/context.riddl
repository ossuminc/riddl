context other  is {
  ???
} with {
  by author Reid
  attachment foo is text/plain as "nada"
}
context 'context' is {
  adaptor 'adaptor' from context other is { ??? }
  function 'function' is { ??? }
  event event is { at: TimeStamp }
  command Act is { why: String }
  entity Actor is {
    state AS of record Acted is { handler AH is { on command Act { do "act" } } }
    record Acted is { done: Boolean }
  }
  handler 'handler' is {
    on event event {
      when "there is a condition" then
        do "handle the event"
      end
    }
  }
  repository 'repository' is { ??? }
  source source is { ??? }
  sink sink is { ??? }
  flow flow is { ??? }
  merge merge is { ??? }
  split split is { ??? }
  saga 'saga' is {
   // a saga body admits comments and types, like every other vital definition
   step a is {
     tell command Act(why = "a.1") to entity Actor
   } reverted by {
     do "a_r.1"
   }
   // compensation runs the completed steps' `reverted by` blocks in reverse order
   step b is {
     tell command Act(why = "b.1") to entity Actor
   } reverted by {
     do "b_r.1"
   }
 }
} with {
  by author Reid
  term term is "not interesting"
}
