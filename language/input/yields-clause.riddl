// Corpus fixture for A19: a command/query type may declare an optional `yields <messageRef>`
// clause between its identifier and its body. A command yields an event; a query yields a result.
// Exercised by both the fastparse parser (TypeParserTest) and the EBNF/TatSu grammar so the two
// accept the same input.
domain d is {
  context c is {
    event OrderPlaced is { id: Integer }
    result OrderFound is { id: Integer }
    command PlaceOrder yields event OrderPlaced is { id: Integer }
    query FindOrder yields result OrderFound is { id: Integer }
    // A plain command with no yields still parses.
    command CancelOrder is { id: Integer }
  }
}
