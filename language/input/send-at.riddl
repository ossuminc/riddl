// Corpus fixture for the scheduled send (2026-09-07): `send <msg> to <portlet> at <instant>`.
// Checked by BOTH the fastparse parser and the EBNF/TatSu grammar validator over **/input/**.
// The instant is any value typed TimeStamp, DateTime or ZonedDateTime -- a message field, a
// constant, or `system.now`. A past instant is delivered immediately; nothing cancels a
// scheduled send. (The ruled "schedule to yourself" idiom needs an outlet looped to the sender's
// own inlet, which `stream-graph-cycle` currently reports as a cycle of one -- BACKLOG [5.6] --
// so this fixture schedules to a downstream sink instead.)
domain Scheduling is {
  context Bookings is {
    command Book is { id: String, startsAt: TimeStamp }
    event ReminderDue is { id: String }
    constant Opening: TimeStamp = "2026-01-01T09:00:00Z"
    inlet BookIn is command Book
    outlet Notify is event ReminderDue
    handler BookingHandler is {
      on b: command Book {
        send event ReminderDue(id = b.id) to outlet Notify at b.startsAt
        send event ReminderDue(id = b.id) to outlet Notify at Opening
        send event ReminderDue(id = b.id) to outlet Notify at system.now
      }
    }
    streamlet Reminders as sink is {
      inlet In is event ReminderDue
      handler RH is { on event ReminderDue { do "remind the customer" } }
    }
    connector Out is from outlet Bookings.Notify to inlet Bookings.Reminders.In
  }
}
